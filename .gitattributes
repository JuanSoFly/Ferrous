# Auto detect text files and perform LF normalization
* text=auto

# Enforce LF for store metadata, CI, and YAML build recipes
fastlane/** text eol=lf
fdroid/** text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Binary files MUST be binary, never converted to text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.so binary
*.jks binary



